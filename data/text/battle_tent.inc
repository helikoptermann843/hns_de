FallarborTown_BattleTentLobby_Text_ExplainFallarborTent:
	.string "Im Kampfcamp von Laubwechselfeld\n"
	.string "findet das K.O.-Teamturnier statt.\p"
	.string "Jeder Teilnehmer darf drei Pokémon\n"
	.string "in den Kampf mitnehmen.\p"
	.string "Diese müssen in der Reihenfolge\n"
	.string "angeordnet werden, in der sie kämpfen\l"
	.string "sollen.\p"
	.string "Diese Reihenfolge wird im Kampf strikt\n"
	.string "eingehalten.\p"
	.string "Ein Pokémon bleibt solange im Kampf,\n"
	.string "bis der Kampf entschieden ist.\p"
	.string "Wenn ein Kampf nach drei Runden noch\n"
	.string "nicht entschieden ist, wird der Sieger\l"
	.string "durch ein richterliches Urteil bestimmt.\p"
	.string "Wenn du deine Herausforderung\n"
	.string "unterbrechen möchtest, speichere\l"
	.string "bitte dein Spiel.\p"
	.string "Wenn du ohne Speichern unterbrichst,\n"
	.string "ist die Herausforderung beendet.\p"
	.string "Besiegst du drei Trainer in Folge,\n"
	.string "gewinnst du einen fantastischen Preis.$"

FallarborTown_BattleTentLobby_Text_SaveBeforeChallenge:
	.string "Bevor du das Kampfcamp betrittst,\n"
	.string "musst du dein Spiel speichern. Okay?$"

