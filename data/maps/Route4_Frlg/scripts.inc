	.string "fangen!$"

Route4_Text_CrissyDefeat::
	.string "Ach, Pilz-Pokémon sind ja so süß!$"

Route4_Text_CrissyPostBattle::
	.string "Es dürfte hier keine Pilz-Pokémon\n"
	.string "mehr geben.\p"
